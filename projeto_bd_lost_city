

CREATE TABLE jogador(
id_jogador SERIAL PRIMARY KEY,
nickname varchar(50) notnull,
email varchar(100) notnull,
senha_hash varchar(255) notnull,
tipo_perfil tipo_perfil_user notnull,
total_partidas_jogadas int,
total_vitorias int,
data_cadastro timestamp,
);


SELECT * FROM jogador;




CREATE TABLE save_state (
  id_save int SERIAL PRIMARY KEY,
  id_partida int notnull,
  vida_atual decimal(5,2) notnull,
  fome_atual decimal(5,2) notnull,
  sede_atual decimal(5,2) notnull,
  posicao_x decimal(10,4) notnull,
  posicao_y decimal(10,4) notnull,
  posicao_z decimal(10,4) notnull,
  capacidade_maxima_peso decimal(6,2) notnull,
  data_salvamento timestamp,
);


SELECT * FROM save_state ;


CREATE TABLE reporte_bug  (
  id_reporte int SERIAL PRIMARY KEY,
  id_jogador int notnull,
  titulo varchar(150) notnull,
  descricao text notnull,
  status status_bug_enum notnull,
  data_envio timestamp,
);


SELECT * FROM reporte_bug;

